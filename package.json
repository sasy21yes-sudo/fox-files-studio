  "devDependencies": {
    "@google/genai": "^2.30.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.56.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0"
  }
